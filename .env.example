# Copy this file to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Account Settings (IMAP)
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your_email_password_or_app_password

# IMAP server settings
# Gmail: imap.gmail.com
# Outlook/Hotmail: imap-mail.outlook.com
# Yahoo: imap.mail.yahoo.com
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# How many days back to fetch emails (default: 7)
FETCH_DAYS=7

# Max emails to fetch per run (default: 50)
MAX_EMAILS=50

# Your name (helps Claude identify financial references to you)
YOUR_NAME=Your Full Name
