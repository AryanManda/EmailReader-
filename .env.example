# Copy this to .env.local for local development.
# In production, set these in the Vercel dashboard under Project Settings → Environment Variables.

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email account credentials (required)
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your_app_password_here

# IMAP server settings
# Gmail:   imap.gmail.com  (use an App Password — https://support.google.com/mail/answer/185833)
# Outlook: imap-mail.outlook.com
# Yahoo:   imap.mail.yahoo.com
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# How many days back to look for emails (default: 7)
FETCH_DAYS=7

# Maximum number of emails to process per run (default: 50)
MAX_EMAILS=50

# Your name — helps Claude identify when money references are about you (optional)
YOUR_NAME=Your Full Name
